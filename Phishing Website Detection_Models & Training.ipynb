   "source": [
    "from sklearn.model_selection import train_test_split\n",
    "\n",
    "# 1. PERSIAPAN KOLOM & TIPE DATA\n",
    "# Rapikan spasi tersembunyi pada nama kolom\n",
    "df.columns = df.columns.str.strip()\n",
    "\n",
    "target_col = \"label\"\n",
    "id_cols = [c for c in [\"url\"] if c in df.columns]\n",
    "\n",
    "# Tentukan kolom fitur (semua kolom kecuali target dan ID)\n",
    "feature_cols = [c for c in df.columns if c not in [target_col] + id_cols]\n",
    "\n",
    "# Siapkan X dan y (Pastikan format numerik)\n",
    "X_all = df[feature_cols].apply(pd.to_numeric, errors=\"coerce\")\n",
    "y_all = pd.to_numeric(df[target_col], errors=\"coerce\").fillna(0).astype(\"int64\")\n",
    "\n",
    "# 2. DATA SPLITTING\n",
    "# Split 80:20 dengan stratifikasi (menjaga rasio kelas target)\n",
    "X_train, X_test, y_train, y_test = train_test_split(\n",
    "    X_all,\n",
    "    y_all,\n",
    "    test_size=0.2,\n",
    "    stratify=y_all,\n",
    "    random_state=12\n",
    ")\n",
    "\n",
    "# 3. IMPUTASI MISSING VALUES\n",
    "# Mencegah data leakage: Hitung median HANYA dari data train\n",
    "med_all = X_train.median(numeric_only=True)\n",
    "\n",
    "# Aplikasikan nilai median tersebut ke data train dan test\n",
    "X_train = X_train.fillna(med_all)\n",
    "X_test = X_test.fillna(med_all)\n",
    "\n",
    "# Metadata untuk cell berikutnya\n",
    "selected_features = list(X_train.columns)\n",
    "ACTIVE_TRAIN_FEATURES = \"all_features\"\n",
    "\n",
    "# 4. OUTPUT\n",
    "# Membuat tabel ringkasan konfigurasi\n",
    "df_config = pd.DataFrame({\n",
    "    \"Pengaturan Pemodelan\": [\"Kolom Target\", \"Total Fitur\", \"Strategi Imputasi\", \"Mode Pelatihan\"],\n",
    "    \"Keterangan\": [target_col, f\"{len(selected_features)} Fitur\", \"Median (dari Data Train)\", ACTIVE_TRAIN_FEATURES]\n",
    "})\n",
    "\n",
    "# Membuat tabel ringkasan dimensi split\n",
    "df_split = pd.DataFrame({\n",
    "    \"Dataset\": [\"Train Data (80%)\", \"Test Data (20%)\"],\n",
    "    \"Jumlah Baris\": [X_train.shape[0], X_test.shape[0]],\n",
    "    \"Jumlah Kolom (Fitur)\": [X_train.shape[1], X_test.shape[1]]\n",
    "})\n",
    "\n",
    "# Menampilkan output\n",
    "print(\"⚙️ KONFIGURASI:\")\n",
    "display(df_config)\n",
    "\n",
    "print(\"\\n📊 DIMENSI DATASET:\")\n",
    "display(df_split)"
   ]
  },
