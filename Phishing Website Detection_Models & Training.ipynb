    "# IMPORT PACKAGES\n",
    "import time\n",
    "import pandas as pd\n",
    "from sklearn.ensemble import RandomForestClassifier\n",
    "from sklearn.metrics import accuracy_score, confusion_matrix # Tambahkan confusion_matrix di sini\n",
    "\n",
    "# 1. KONFIGURASI MODEL RANDOM FOREST\n",
    "# Menyimpan parameter dalam dictionary agar rapi dan mudah diubah\n",
    "rf_params = {\n",
    "    \"n_estimators\": 200,\n",
    "    \"max_depth\": 5,\n",
    "    \"random_state\": 12,\n",
    "    \"n_jobs\": -1  # -1 berarti menggunakan seluruh core CPU\n",
    "}\n",
    "\n",
    "# Inisialisasi model menggunakan dictionary unpacking (**)\n",
    "forest = RandomForestClassifier(**rf_params)\n",
    "\n",
    "# Membuat DataFrame untuk menampilkan konfigurasi parameter\n",
    "df_rf_config = pd.DataFrame({\n",
    "    \"Hyperparameter\": rf_params.keys(),\n",
    "    \"Nilai yang Digunakan\": rf_params.values(),\n",
    "    \"Keterangan\": [\n",
    "        \"Jumlah pohon (*decision trees*) yang dibuat\",\n",
    "        \"Batas kedalaman pohon (mencegah overfitting)\",\n",
    "        \"Seed acak agar hasil selalu konsisten (*reproducible*)\",\n",
    "        \"Penggunaan core CPU komputasi paralel\"\n",
    "    ]\n",
    "})\n",
    "\n",
    "# 2. PROSES PELATIHAN (MODEL FITTING)\n",
    "print(\"⏳ Memulai pelatihan model Random Forest...\")\n",
    "start_time = time.time()\n",
    "\n",
    "# Fit model ke data latih\n",
    "forest.fit(X_train, y_train)\n",
    "\n",
    "end_time = time.time()\n",
    "training_duration = end_time - start_time\n",
    "\n",
    "# 3. PREDIKSI & EVALUASI MODEL\n",
    "# Melakukan prediksi menggunakan model yang sudah dilatih\n",
    "y_train_forest = forest.predict(X_train)\n",
    "y_test_forest = forest.predict(X_test)\n",
    "\n",
    "# A. Akurasi Model\n",
    "acc_train_forest = accuracy_score(y_train, y_train_forest)\n",
    "acc_test_forest = accuracy_score(y_test, y_test_forest)\n",
    "\n",
    "# Menghitung selisih (gap) antara akurasi train dan test untuk cek overfitting\n",
    "gap_accuracy = abs(acc_train_forest - acc_test_forest)\n",
    "\n",
    "# Membungkus hasil evaluasi akurasi ke dalam DataFrame\n",
    "df_rf_performance = pd.DataFrame({\n",
    "    \"Dataset Evaluasi\": [\"Training Data (80%)\", \"Test Data (20%)\", \"Selisih (Gap)\"],\n",
    "    \"Nilai Akurasi\": [f\"{acc_train_forest:.2%}\", f\"{acc_test_forest:.2%}\", f\"{gap_accuracy:.2%}\"]\n",
    "})\n",
    "\n",
    "# B. Confusion Matrix\n",
    "cm_forest = confusion_matrix(y_test, y_test_forest)\n",
    "\n",
    "# Membungkus Confusion Matrix ke dalam DataFrame agar ada label baris & kolom\n",
    "df_rf_cm = pd.DataFrame(\n",
    "    cm_forest,\n",
    "    index=['Actual Benign (0)', 'Actual Phishing (1)'],\n",
    "    columns=['Predicted Benign (0)', 'Predicted Phishing (1)']\n",
    ")\n",
    "\n",
    "# 4. OUTPUT \n",
    "print(f\"✅ PELATIHAN & EVALUASI SELESAI! (Waktu eksekusi: {training_duration:.2f} detik)\")\n",
    "print(\"=\" * 65)\n",
    "\n",
    "print(\"\\n⚙️ KONFIGURASI MODEL:\")\n",
    "display(df_rf_config.style.set_properties(**{'text-align': 'left'}))\n",
    "\n",
    "print(\"\\n🎯 HASIL EVALUASI AKURASI: RANDOM FOREST\")\n",
    "display(df_rf_performance.style.set_properties(**{'text-align': 'left'}))\n",
    "\n",
    "print(\"\\n📊 CONFUSION MATRIX (TEST DATA):\")\n",
    "display(df_rf_cm) # Menampilkan tabel rincian tebakan (TN, FP, FN, TP)"
   ]
  },
