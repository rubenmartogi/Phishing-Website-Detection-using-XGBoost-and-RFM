   "source": [
    "# IMPORT PACKAGES\n",
    "import time\n",
    "import pandas as pd\n",
    "from sklearn.ensemble import StackingClassifier\n",
    "from sklearn.linear_model import LogisticRegression\n",
    "from sklearn.metrics import accuracy_score, confusion_matrix\n",
    "\n",
    "# 1. KONFIGURASI MODEL STACKING ENSEMBLE\n",
    "# Mendefinisikan model dasar (Base Learners)\n",
    "# Catatan: Pastikan variabel 'forest' dan 'xgb' sudah didefinisikan & dilatih sebelumnya\n",
    "base_learners = [\n",
    "    (\"rf\", forest),\n",
    "    (\"xgb\", xgb),\n",
    "]\n",
    "\n",
    "# Mendefinisikan meta-model (Final Estimator)\n",
    "meta_learner = LogisticRegression(max_iter=1000, class_weight=\"balanced\", random_state=12)\n",
    "\n",
    "# Inisialisasi Stacking Classifier\n",
    "stack_model = StackingClassifier(\n",
    "    estimators=base_learners,\n",
    "    final_estimator=meta_learner,\n",
    "    stack_method=\"predict_proba\",\n",
    "    n_jobs=-1\n",
    ")\n",
    "\n",
    "# Membuat DataFrame untuk menampilkan struktur arsitektur Stacking\n",
    "df_stack_config = pd.DataFrame({\n",
    "    \"Komponen Stacking\": [\n",
    "        \"Base Learner 1\", \n",
    "        \"Base Learner 2\", \n",
    "        \"Meta-Learner (Final)\", \n",
    "        \"Metode Stacking\"\n",
    "    ],\n",
    "    \"Model / Pengaturan\": [\n",
    "        \"Random Forest Classifier\",\n",
    "        \"XGBoost Classifier\",\n",
    "        \"Logistic Regression (class_weight='balanced')\",\n",
    "        \"predict_proba (Probabilitas)\"\n",
    "    ],\n",
    "    \"Keterangan\": [\n",
    "        \"Mengekstrak pola paralel menggunakan banyak decision tree\",\n",
    "        \"Mengekstrak pola secara berurutan (boosting) meminimalkan error\",\n",
    "        \"Mempelajari cara terbaik menggabungkan tebakan dari RF dan XGB\",\n",
    "        \"Meta-learner menggunakan nilai probabilitas, bukan label mutlak 0/1\"\n",
    "    ]\n",
    "})\n",
    "\n",
    "# 2. PROSES PELATIHAN (MODEL FITTING)\n",
    "print(\"⏳ Memulai pelatihan model Stacking Ensemble (RF + XGB -> LogReg)...\")\n",
    "start_time = time.time()\n",
    "\n",
    "# Fit model ke data latih\n",
    "stack_model.fit(X_train, y_train)\n",
    "\n",
    "end_time = time.time()\n",
    "training_duration = end_time - start_time\n",
    "\n",
    "# 3. PREDIKSI & EVALUASI METRIK\n",
    "# Melakukan prediksi\n",
    "y_train_stack = stack_model.predict(X_train)\n",
    "y_test_stack = stack_model.predict(X_test)\n",
    "\n",
    "# A. Akurasi & Cek Overfitting\n",
    "acc_train_stack = accuracy_score(y_train, y_train_stack)\n",
    "acc_test_stack = accuracy_score(y_test, y_test_stack)\n",
    "gap_accuracy = abs(acc_train_stack - acc_test_stack)\n",
    "\n",
    "df_stack_acc = pd.DataFrame({\n",
    "    \"Dataset Evaluasi\": [\"Training Data (80%)\", \"Test Data (20%)\", \"Selisih (Gap)\"],\n",
    "    \"Nilai Akurasi\": [f\"{acc_train_stack:.2%}\", f\"{acc_test_stack:.2%}\", f\"{gap_accuracy:.2%}\"]\n",
    "})\n",
    "\n",
    "# B. Confusion Matrix\n",
    "cm_stack = confusion_matrix(y_test, y_test_stack)\n",
    "df_stack_cm = pd.DataFrame(\n",
    "    cm_stack,\n",
    "    index=['Actual Benign (0)', 'Actual Phishing (1)'],\n",
    "    columns=['Predicted Benign (0)', 'Predicted Phishing (1)']\n",
    ")\n",
    "\n",
    "# 4. VISUALISASI OUTPUT KESELURUHAN\n",
    "print(f\"✅ PELATIHAN SELESAI! (Waktu eksekusi: {training_duration:.2f} detik)\")\n",
    "print(\"=\" * 70)\n",
    "\n",
    "print(\"\\n⚙️ ARSITEKTUR MODEL STACKING:\")\n",
    "display(df_stack_config.style.set_properties(**{'text-align': 'left'}))\n",
    "\n",
    "print(\"\\n🎯 HASIL EVALUASI AKURASI: STACKING ENSEMBLE\")\n",
    "display(df_stack_acc.style.set_properties(**{'text-align': 'left'}))\n",
    "\n",
    "print(\"\\n📊 CONFUSION MATRIX (TEST DATA):\")\n",
    "display(df_stack_cm)"
   ]
