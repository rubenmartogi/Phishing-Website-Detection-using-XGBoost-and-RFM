    "    \"Jumlah Data\": [tn, fp, fn, tp],\n",
    "    \"Indikator\": [\"✅ Tepat\", \"❌ Salah Alarm\", \"❌ Lolos Deteksi\", \"✅ Tepat\"],\n",
