    "# IMPORT PACKAGES\n",
    "import time\n",
    "import pandas as pd\n",
    "from xgboost import XGBClassifier\n",
    "from sklearn.metrics import accuracy_score, confusion_matrix\n",
    "\n",
    "# 1. KONFIGURASI MODEL XGBOOST\n",
    "# Menyimpan parameter secara terpisah (konservatif untuk meminimalisir overfitting)\n",
    "xgb_params = {\n",
    "    \"n_estimators\": 200,\n",
    "    \"learning_rate\": 0.1,\n",
    "    \"max_depth\": 4,\n",
    "    \"reg_lambda\": 1.0,\n",
    "    \"reg_alpha\": 0.1,\n",
    "    \"subsample\": 0.8,\n",
    "    \"colsample_bytree\": 0.8,\n",
    "    \"gamma\": 0.1,\n",
    "    \"min_child_weight\": 2,\n",
    "    \"random_state\": 12,\n",
    "    \"n_jobs\": -1,\n",
    "    \"eval_metric\": \"logloss\"\n",
    "}\n",
    "\n",
    "# Inisialisasi model\n",
    "xgb = XGBClassifier(**xgb_params)\n",
    "\n",
    "# Membuat DataFrame untuk menampilkan konfigurasi parameter\n",
    "df_xgb_config = pd.DataFrame({\n",
    "    \"Hyperparameter\": list(xgb_params.keys()),\n",
    "    \"Nilai yang Digunakan\": list(xgb_params.values()),\n",
    "    \"Keterangan\": [\n",
    "        \"Jumlah iterasi boosting (pohon yang dibangun)\",\n",
    "        \"Langkah penyusutan (*shrinkage*) untuk mencegah overfitting\",\n",
    "        \"Batas kedalaman maksimal setiap pohon\",\n",
    "        \"Regularisasi L2 (Ridge) pada bobot daun\",\n",
    "        \"Regularisasi L1 (Lasso) pada bobot daun\",\n",
    "        \"Rasio sampel baris (observasi) per pohon\",\n",
    "        \"Rasio sampel kolom (fitur) per pohon\",\n",
    "        \"Minimum *loss reduction* untuk membagi cabang\",\n",
    "        \"Minimum jumlah bobot instance (*Hessian*) di daun\",\n",
    "        \"Seed acak agar hasil selalu konsisten (*reproducible*)\",\n",
    "        \"Penggunaan core CPU komputasi paralel\",\n",
    "        \"Metrik evaluasi internal saat pelatihan\"\n",
    "    ]\n",
    "})\n",
    "\n",
    "# 2. PROSES PELATIHAN (MODEL FITTING)\n",
    "print(\"⏳ Memulai pelatihan model XGBoost...\")\n",
    "start_time = time.time()\n",
    "\n",
    "# Fit model ke data latih\n",
    "xgb.fit(X_train, y_train)\n",
    "\n",
    "end_time = time.time()\n",
    "training_duration = end_time - start_time\n",
    "\n",
    "# 3. PREDIKSI PADA DATA TRAIN & TEST\n",
    "y_train_xgb = xgb.predict(X_train)\n",
    "y_test_xgb = xgb.predict(X_test)\n",
    "\n",
    "# 4. EVALUASI METRIK\n",
    "# A. Akurasi & Cek Overfitting\n",
    "acc_train_xgb = accuracy_score(y_train, y_train_xgb)\n",
    "acc_test_xgb = accuracy_score(y_test, y_test_xgb)\n",
    "gap_accuracy = abs(acc_train_xgb - acc_test_xgb)\n",
    "\n",
    "df_xgb_acc = pd.DataFrame({\n",
    "    \"Dataset Evaluasi\": [\"Training Data (80%)\", \"Test Data (20%)\", \"Selisih (Gap)\"],\n",
    "    \"Nilai Akurasi\": [f\"{acc_train_xgb:.2%}\", f\"{acc_test_xgb:.2%}\", f\"{gap_accuracy:.2%}\"]\n",
    "})\n",
    "\n",
    "# B. Confusion Matrix (dalam bentuk DataFrame)\n",
    "cm_xgb = confusion_matrix(y_test, y_test_xgb)\n",
    "df_xgb_cm = pd.DataFrame(\n",
    "    cm_xgb,\n",
    "    index=['Actual Benign (0)', 'Actual Phishing (1)'],\n",
    "    columns=['Predicted Benign (0)', 'Predicted Phishing (1)']\n",
    ")\n",
    "\n",
    "# 5. OUTPUT \n",
    "print(f\"✅ PELATIHAN & EVALUASI SELESAI! (Waktu eksekusi: {training_duration:.2f} detik)\")\n",
    "print(\"=\" * 65)\n",
    "\n",
    "print(\"\\n⚙️ KONFIGURASI MODEL XGBOOST:\")\n",
    "display(df_xgb_config.style.set_properties(**{'text-align': 'left'}))\n",
    "\n",
    "print(\"\\n🎯 HASIL EVALUASI AKURASI: XGBOOST\")\n",
    "display(df_xgb_acc.style.set_properties(**{'text-align': 'left'}))\n",
    "\n",
    "print(\"\\n📊 CONFUSION MATRIX (TEST DATA):\")\n",
    "display(df_xgb_cm)"
   ]
  },
